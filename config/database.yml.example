# Copy to config/database.yml and set this machine's own credentials.
# That file is gitignored; CI uses config/database.yml.ci.

default: &default
  adapter: postgresql
  encoding: unicode
  pool: <%= ENV.fetch("RAILS_MAX_THREADS") { 5 } %>
  # Keeps db/structure.sql to the public schema, so an extension installed on
  # one machine does not turn up as noise in everyone else's diff.
  dump_schemas: public
  host: <%= ENV.fetch("DB_HOST", "localhost") %>
  port: <%= ENV.fetch("DB_PORT", 5432) %>
  username: <%= ENV.fetch("DB_USERNAME", "postgres") %>
  password: <%= ENV.fetch("DB_PASSWORD", "postgres") %>

development:
  <<: *default
  database: school_development

test:
  <<: *default
  database: school_test

# Solid Cache/Queue/Cable each get their own database in production.
production:
  primary: &primary_production
    <<: *default
    database: school_production
    username: school
    password: <%= ENV["SCHOOL_DATABASE_PASSWORD"] %>
  cache:
    <<: *primary_production
    database: school_production_cache
    migrations_paths: db/cache_migrate
  queue:
    <<: *primary_production
    database: school_production_queue
    migrations_paths: db/queue_migrate
  cable:
    <<: *primary_production
    database: school_production_cable
    migrations_paths: db/cable_migrate
