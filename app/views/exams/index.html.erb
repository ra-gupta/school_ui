<% content_for :title, "Exams" %>
<%= render "shared/header", title: "Exams", actions: (link_to("New exam", new_exam_path, class: "rounded-lg bg-slate-900 px-4 py-2 text-sm text-white") if current_user.can?("exams.write")) %>
<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <% @exams.each do |e| %>
    <%= link_to e, class: "rounded-xl border border-slate-200 bg-white p-5 hover:border-slate-400" do %>
      <p class="font-medium"><%= e.name %></p>
      <p class="mt-1 text-sm text-slate-500"><%= e.exam_type.humanize %> · <%= e.starts_on&.to_fs(:long) %></p>
      <p class="mt-3 text-xs"><span class="rounded-full px-2 py-0.5 <%= e.published? ? "bg-emerald-100 text-emerald-700" : "bg-slate-100 text-slate-600" %>"><%= e.published? ? "Published" : "Draft" %></span>
        <span class="ml-2 text-slate-500"><%= e.exam_schedules.count %> papers</span></p>
    <% end %>
  <% end %>
  <% if @exams.empty? %><p class="text-slate-400">No exams yet.</p><% end %>
</div>
