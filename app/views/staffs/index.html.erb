<% content_for :title, "Staff" %>
<%= render "shared/header", title: "Staff", actions: (link_to("Add staff", new_staff_path, class: "rounded-lg bg-slate-900 px-4 py-2 text-sm text-white") if current_user.can?("hr.write")) %>

<%= form_with url: staffs_path, method: :get, class: "mb-4 flex flex-wrap gap-2" do %>
  <%= text_field_tag :q, params[:q], placeholder: "Name or employee no", class: "w-64 rounded-lg border-slate-300 text-sm" %>
  <%= select_tag :department_id, options_from_collection_for_select(@departments, :id, :name, params[:department_id]), include_blank: "All departments", class: "rounded-lg border-slate-300 text-sm" %>
  <%= select_tag :status, options_for_select(%w[active inactive], params[:status] || "active"), class: "rounded-lg border-slate-300 text-sm" %>
  <%= submit_tag "Filter", class: "rounded-lg bg-slate-200 px-4 py-2 text-sm", name: nil %>
<% end %>

<div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
  <table class="w-full text-sm">
    <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
      <tr><th class="p-3">Emp. no</th><th class="p-3">Name</th><th class="p-3">Designation</th><th class="p-3">Department</th><th class="p-3">Phone</th><th class="p-3 text-right">Salary</th></tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @staffs.each do |s| %>
        <tr class="hover:bg-slate-50">
          <td class="p-3 font-mono text-xs text-slate-500"><%= s.employee_no %></td>
          <td class="p-3 font-medium"><%= link_to s.name, s, class: "hover:underline" %></td>
          <td class="p-3"><%= s.designation %></td>
          <td class="p-3 text-slate-500"><%= s.department&.name %></td>
          <td class="p-3 text-slate-500"><%= s.phone %></td>
          <td class="p-3 text-right"><%= number_to_currency(s.basic_salary, unit: "₹", precision: 0) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render "shared/pager" %>
</div>
