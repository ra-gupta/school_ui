<% content_for :title, @staff.name %>
<%= render "shared/header", title: @staff.name, actions: (link_to("Edit", edit_staff_path(@staff), class: "rounded-lg border border-slate-300 px-4 py-2 text-sm") if current_user.can?("hr.write")) %>
<div class="grid gap-6 lg:grid-cols-2">
  <section class="rounded-xl border border-slate-200 bg-white p-5">
    <dl class="space-y-2 text-sm">
      <% { "Employee no" => @staff.employee_no, "Designation" => @staff.designation, "Department" => @staff.department&.name,
           "Joined" => @staff.joining_date&.to_fs(:long), "Qualification" => @staff.qualification,
           "Phone" => @staff.phone, "Email" => @staff.email, "Biometric ID" => @staff.biometric_id,
           "Basic salary" => number_to_currency(@staff.basic_salary, unit: "₹", precision: 0),
           "Status" => @staff.status.humanize }.each do |k, v| %>
        <div class="flex justify-between gap-4"><dt class="text-slate-500"><%= k %></dt><dd class="text-right"><%= v.presence || "—" %></dd></div>
      <% end %>
    </dl>
  </section>
  <section class="rounded-xl border border-slate-200 bg-white p-5">
    <h2 class="mb-3 text-sm font-semibold text-slate-700">Class teacher of</h2>
    <p class="text-sm"><%= @sections.map(&:full_name).join(", ").presence || "—" %></p>
    <h2 class="mt-5 mb-3 text-sm font-semibold text-slate-700">Attendance · last 30 days</h2>
    <div class="flex flex-wrap gap-1">
      <% @attendance.each do |a| %>
        <span class="h-6 w-6 rounded text-center text-[10px] leading-6 text-white <%= { "present" => "bg-emerald-500", "absent" => "bg-red-500", "late" => "bg-amber-500", "leave" => "bg-slate-400" }[a.status] || "bg-slate-200" %>" title="<%= a.on_date %>"><%= a.on_date.day %></span>
      <% end %>
      <% if @attendance.empty? %><p class="text-sm text-slate-400">Nothing recorded.</p><% end %>
    </div>
  </section>
</div>
