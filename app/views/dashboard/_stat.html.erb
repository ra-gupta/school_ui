<div class="rounded-xl border border-slate-200 bg-white p-5">
  <div class="flex items-start justify-between">
    <p class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= label %></p>
    <% if local_assigns[:icon] %>
      <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg text-sm <%= local_assigns[:tint] %>"><%= icon %></span>
    <% end %>
  </div>
  <p class="mt-2 text-3xl font-semibold tracking-tight"><%= value %></p>
  <% if local_assigns[:foot] %><p class="mt-1 text-xs text-slate-500"><%= foot %></p><% end %>
</div>
