<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || current_school&.name || "School ERP" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag "tailwind", "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <style>:root { --brand: <%= current_school&.primary_color || "#4f46e5" %>; }</style>
  </head>

  <body class="h-full bg-slate-100 text-slate-900">
    <% if authenticated? %>
      <div class="flex min-h-full">
        <%= render "layouts/sidebar" %>
        <div class="flex min-w-0 flex-1 flex-col">
          <%= render "layouts/topbar" %>
          <main class="flex-1 p-6">
            <%= render "layouts/flash" %>
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <main class="mx-auto max-w-md p-6">
        <%= render "layouts/flash" %>
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
