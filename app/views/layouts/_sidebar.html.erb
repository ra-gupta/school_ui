<aside class="hidden w-64 shrink-0 flex-col overflow-y-auto bg-slate-900 text-slate-300 md:flex">
  <div class="flex items-center gap-2 px-5 py-4 text-white">
    <span class="grid h-8 w-8 place-items-center rounded-lg text-sm font-bold" style="background: var(--brand)">
      <%= (current_school&.name || "ERP").first %>
    </span>
    <span class="truncate font-semibold"><%= current_school&.name || "Super Admin" %></span>
  </div>

  <nav class="flex-1 space-y-6 px-3 pb-8">
    <%= link_to root_path, class: "block rounded-lg px-3 py-2 text-sm font-medium #{current_page?(root_path) ? "bg-slate-800 text-white" : "hover:bg-slate-800"}" do %>
      🏠 Dashboard
    <% end %>

    <% nav_modules.group_by(&:group).each do |group, mods| %>
      <div>
        <p class="px-3 pb-1 text-xs font-semibold uppercase tracking-wider text-slate-500"><%= group %></p>
        <% mods.each do |m| %>
          <%= link_to m.path, class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm hover:bg-slate-800 #{"bg-slate-800 text-white" if request.path.start_with?(m.path)}" do %>
            <span><%= m.icon %></span><span class="truncate"><%= m.name %></span>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if current_user.super_admin? %>
      <div>
        <p class="px-3 pb-1 text-xs font-semibold uppercase tracking-wider text-slate-500">Platform</p>
        <%= link_to "🏫 Schools", schools_path, class: "flex gap-2 rounded-lg px-3 py-2 text-sm hover:bg-slate-800" %>
      </div>
    <% end %>
  </nav>
</aside>
