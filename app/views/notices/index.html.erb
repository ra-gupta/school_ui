<% content_for :title, "Notices" %>
<%= render "shared/header", title: "Notices", actions: (link_to("Post notice", new_notice_path, class: "rounded-lg bg-slate-900 px-4 py-2 text-sm text-white") if current_user.can?("notices.write")) %>
<div class="space-y-3">
  <% @notices.each do |n| %>
    <article class="rounded-xl border border-slate-200 bg-white p-5">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="font-medium"><%= link_to n.title, n, class: "hover:underline" %></h2>
          <p class="mt-1 text-sm text-slate-500"><%= truncate(n.body, length: 160) %></p>
        </div>
        <div class="shrink-0 text-right text-xs text-slate-500">
          <span class="rounded-full bg-slate-100 px-2 py-0.5"><%= n.audience %></span>
          <p class="mt-1"><%= n.published_at ? time_ago_in_words(n.published_at) + " ago" : "draft" %></p>
        </div>
      </div>
    </article>
  <% end %>
  <% if @notices.empty? %><p class="text-slate-400">Nothing posted.</p><% end %>
</div>
<%= render "shared/pager" %>
