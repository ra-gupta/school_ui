<% content_for :title, "Homework" %>
<%= render "shared/header", title: "Homework", actions: (link_to("Assign", new_homework_path, class: "rounded-lg bg-slate-900 px-4 py-2 text-sm text-white") if current_user.can?("homework.write")) %>
<%= form_with url: homeworks_path, method: :get, class: "mb-4 flex gap-2" do %>
  <%= select_tag :section_id, options_from_collection_for_select(@sections, :id, :full_name, params[:section_id]), include_blank: "All sections", class: "rounded-lg border-slate-300 text-sm" %>
  <%= submit_tag "Filter", class: "rounded-lg bg-slate-200 px-4 py-2 text-sm", name: nil %>
<% end %>
<div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
  <table class="w-full text-sm">
    <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
      <tr><th class="p-3">Title</th><th class="p-3">Class</th><th class="p-3">Subject</th><th class="p-3">Assigned</th><th class="p-3">Due</th></tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @homeworks.each do |h| %>
        <tr class="hover:bg-slate-50">
          <td class="p-3 font-medium"><%= link_to h.title, h, class: "hover:underline" %></td>
          <td class="p-3"><%= h.section.full_name %></td>
          <td class="p-3 text-slate-500"><%= h.subject&.name %></td>
          <td class="p-3 text-slate-500"><%= h.assigned_on.to_fs(:long) %></td>
          <td class="p-3 <%= "text-red-600" if h.due_on && h.due_on < Date.current %>"><%= h.due_on&.to_fs(:long) %></td>
        </tr>
      <% end %>
      <% if @homeworks.empty? %><tr><td colspan="5" class="p-8 text-center text-slate-400">Nothing assigned.</td></tr><% end %>
    </tbody>
  </table>
  <%= render "shared/pager" %>
</div>
