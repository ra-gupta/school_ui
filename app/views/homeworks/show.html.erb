<% content_for :title, @homework.title %>
<%= render "shared/header", title: @homework.title, actions: (link_to("Edit", edit_homework_path(@homework), class: "rounded-lg border border-slate-300 px-4 py-2 text-sm") if current_user.can?("homework.write")) %>
<div class="grid gap-6 lg:grid-cols-3">
  <section class="rounded-xl border border-slate-200 bg-white p-5 lg:col-span-2">
    <p class="text-sm text-slate-500"><%= @homework.section.full_name %> · <%= @homework.subject&.name %> · due <%= @homework.due_on&.to_fs(:long) %></p>
    <p class="mt-3 whitespace-pre-line text-sm"><%= @homework.description %></p>
  </section>
  <section class="rounded-xl border border-slate-200 bg-white p-5">
    <h2 class="mb-3 text-sm font-semibold text-slate-700">Submissions (<%= @submissions.size %>)</h2>
    <ul class="space-y-1 text-sm">
      <% @submissions.each do |s| %>
        <li class="flex justify-between"><span><%= s.student.name %></span><span class="text-slate-500"><%= s.submitted_at ? "submitted" : s.status %></span></li>
      <% end %>
      <% if @submissions.empty? %><li class="text-slate-400">None yet.</li><% end %>
    </ul>
  </section>
</div>
