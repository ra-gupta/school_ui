<% content_for :title, "Live tracking" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "leaflet" %>
  <style>
    .bus-marker { background: none; border: none; }
    .bus-marker__wrap { position: relative; width: 40px; height: 40px; }
    .bus-marker__ring { position: absolute; inset: 4px; border-radius: 9999px; background: #fff; color: #e34948;
      box-shadow: 0 0 0 3px rgba(227,73,72,.25), 0 2px 6px rgba(0,0,0,.25); display: grid; place-items: center; }
    .bus-marker__ring svg { width: 20px; height: 20px; }
    .bus-marker__pointer { position: absolute; inset: 0; transition: transform .6s ease; }
    .bus-marker__pointer span { position: absolute; left: 50%; top: -2px; width: 0; height: 0; margin-left: -6px;
      border-left: 6px solid transparent; border-right: 6px solid transparent; border-bottom: 9px solid #e34948; }
    .bus-popup .leaflet-popup-content-wrapper { border-radius: 10px; box-shadow: 0 8px 24px rgba(0,0,0,.18); }
    .bus-popup .leaflet-popup-content { margin: 12px 14px; font-size: 12px; line-height: 1.5; }
    .bus-detail__title { font-weight: 600; font-size: 13px; }
    .bus-detail__place { color: #52514e; margin: 2px 0 8px; }
    .bus-detail dl { display: grid; grid-template-columns: auto 1fr; gap: 2px 10px; }
    .bus-detail dt { color: #898781; } .bus-detail dd { margin: 0; font-variant-numeric: tabular-nums; }
    .bus-detail a { color: #2a78d6; text-decoration: underline; }
    .bus-label { background: #0b0b0b; color: #fff; border: 0; border-radius: 6px; padding: 2px 6px; font-size: 11px; font-weight: 600; }
    .bus-label::before { display: none; }
    .is-live [data-field="status"] { color: #0ca30c; }
    .is-active { background: #0b0b0b !important; color: #fff !important; }
  </style>
<% end %>
<%= render "shared/header", title: "Live tracking" %>

<div data-controller="live-map" data-live-map-vehicles-value="<%= @payload.to_json %>"
     class="grid gap-4 lg:grid-cols-4">
  <aside class="space-y-2 lg:col-span-1">
    <% @vehicles.each do |v| %>
      <div data-vehicle="<%= v.id %>" class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0">
            <p class="font-medium"><%= v.registration_no %></p>
            <p class="truncate text-xs text-slate-500"><%= v.driver&.name || "no driver" %><%= " · #{v.transport_routes.map(&:name).join(", ")}" if v.transport_routes.any? %></p>
          </div>
          <span data-field="status" class="shrink-0 text-xs font-semibold text-slate-500">—</span>
        </div>
        <dl class="mt-3 grid grid-cols-3 gap-2 text-center text-xs">
          <div><dt class="text-slate-500">Speed</dt><dd data-field="speed" class="mt-0.5 font-semibold tabular-nums">—</dd></div>
          <div><dt class="text-slate-500">Next stop</dt><dd data-field="next" class="mt-0.5 truncate font-semibold">—</dd></div>
          <div><dt class="text-slate-500">ETA</dt><dd data-field="eta" class="mt-0.5 font-semibold tabular-nums">—</dd></div>
        </dl>
        <div class="mt-3 grid grid-cols-2 gap-2">
          <button type="button" data-action="live-map#follow" data-vehicle="<%= v.id %>"
                  class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50">Follow</button>
          <button type="button" data-action="live-map#locate" data-vehicle="<%= v.id %>"
                  class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50">Where is it?</button>
        </div>
      </div>
    <% end %>
    <% if @vehicles.empty? %><p class="text-sm text-slate-400">No vehicles yet.</p><% end %>
  </aside>

  <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm lg:col-span-3">
    <div data-live-map-target="map" class="h-full min-h-[36rem] w-full"></div>
  </div>
</div>
