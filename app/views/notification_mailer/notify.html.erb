<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #0b0b0b; max-width: 32rem;">
  <p style="font-size: 15px; line-height: 1.6; white-space: pre-line;"><%= @log.body %></p>
  <hr style="border: none; border-top: 1px solid #e1e0d9; margin: 24px 0;">
  <p style="font-size: 12px; color: #898781;">
    <%= @school.name %><%= " · #{@school.phone}" if @school.phone.present? %><br>
    You are receiving this because you are listed as a contact at this school.
  </p>
</div>
