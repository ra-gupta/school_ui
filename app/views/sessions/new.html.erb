<div class="mx-auto w-full max-w-sm py-12">
  <div class="mb-8 text-center">
    <span class="mx-auto mb-3 grid h-12 w-12 place-items-center rounded-xl bg-slate-900 text-lg font-bold text-white">S</span>
    <h1 class="text-2xl font-semibold tracking-tight">Sign in</h1>
    <p class="mt-1 text-sm text-slate-500">Parents and students can use their mobile number.</p>
  </div>


  <%= form_with url: session_url, class: "space-y-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm" do |form| %>
    <label class="block">
      <span class="text-sm font-medium text-slate-700">Email or mobile number</span>
      <%# type=text, not email: a mobile number is a valid entry here and the
          browser would otherwise refuse to submit it. %>
      <%= form.text_field :login, required: true, autofocus: true, autocomplete: "username",
            inputmode: "email", placeholder: "you@school.test or 9900000000", value: params[:login],
            class: "mt-1 w-full rounded-lg border-slate-300 shadow-sm focus:border-slate-400 focus:ring-0" %>
    </label>

    <label class="block">
      <span class="text-sm font-medium text-slate-700">Password</span>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
            placeholder: "Enter your password",
            class: "mt-1 w-full rounded-lg border-slate-300 shadow-sm focus:border-slate-400 focus:ring-0" %>
    </label>

    <%= form.submit "Sign in", class: "w-full cursor-pointer rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-medium text-white hover:bg-slate-800" %>

    <p class="text-center text-sm text-slate-500">
      <%= link_to "Forgot password?", new_password_path, class: "underline hover:no-underline" %>
    </p>
  <% end %>
</div>
